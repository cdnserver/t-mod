{
    admin off
    email tvr@ultra---industries.com
    servers {
        protocols h1 h2 h3
    }
}

{$CDN_DOMAIN:cdn.tvr.lat} {
    encode zstd gzip

    @health path /cdn-health
    respond @health 200 {
        body "ok"
        close
    }

    @blocked {
        path /.git/* /.env* /*.db /*.sqlite* /*.pem /*.key /*.log
    }
    respond @blocked 404

    @immutable path /immutable/* /releases/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    @regular not path /cdn-health /immutable/* /releases/*
    header @regular Cache-Control "public, max-age=300, stale-while-revalidate=60"

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Cross-Origin-Resource-Policy "cross-origin"
        Access-Control-Allow-Origin "*"
    }

    root * /srv/cdn/current
    file_server

    log {
        output file /var/log/caddy/access.json {
            roll_size 50MiB
            roll_keep 10
            roll_keep_for 168h
        }
        format json
    }
}

