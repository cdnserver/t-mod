#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

collection="${ATLAS_QDRANT_COLLECTION:-tmod_atlas_v1}"
endpoint="${ATLAS_QDRANT_LOCAL_URL:-http://127.0.0.1:6333}"
backup_dir=/var/backups/tmod-postgres
passphrase=/root/.tmod/backup-passphrase
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
encrypted="${backup_dir}/.atlas-qdrant-${stamp}.snapshot.gpg.tmp"
target="${backup_dir}/atlas-qdrant-${stamp}.snapshot.gpg"
snapshot_name=""
snapshot_path=""

cleanup() {
  rm -f "${encrypted}"
  if [[ -n "${snapshot_name}" ]]; then
    curl --fail --silent --show-error --request DELETE \
      "${endpoint}/collections/${collection}/snapshots/${snapshot_name}" >/dev/null || true
  fi
}
trap cleanup EXIT

response="$(curl --fail --silent --show-error --request POST \
  "${endpoint}/collections/${collection}/snapshots")"
snapshot_name="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["name"])' <<<"${response}")"
snapshot_path="/var/lib/tmod/qdrant-snapshots/${collection}/${snapshot_name}"
test -s "${snapshot_path}"
plain_sha="$(sha256sum "${snapshot_path}" | awk '{print $1}')"

gpg --batch --yes --pinentry-mode loopback --passphrase-file "${passphrase}" \
  --symmetric --cipher-algo AES256 --output "${encrypted}" "${snapshot_path}"
decrypted_sha="$(gpg --batch --quiet --pinentry-mode loopback \
  --passphrase-file "${passphrase}" --decrypt "${encrypted}" | sha256sum | awk '{print $1}')"
test "${plain_sha}" = "${decrypted_sha}"

chmod 0600 "${encrypted}"
mv "${encrypted}" "${target}"
sha256sum "${target}" > "${target}.sha256"
chmod 0600 "${target}.sha256"
find "${backup_dir}" -type f -name 'atlas-qdrant-*.snapshot.gpg' -mtime +14 -delete
find "${backup_dir}" -type f -name 'atlas-qdrant-*.snapshot.gpg.sha256' -mtime +14 -delete
