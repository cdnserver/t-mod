{
  "name": "tmod-desktop",
  "version": "1.3.5-p4",
  "description": "Единый рабочий хаб экосистемы T-Mod",
  "main": "./out/main/index.js",
  "author": "TVR x SGL",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:lumen": "node scripts/build-blackbird.mjs build",
    "build:blackbird": "node scripts/build-blackbird.mjs build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node --check out/main/index.js && node --check out/preload/index.cjs",
    "package": "pnpm build && electron-builder --dir",
    "package:lumen": "node scripts/build-blackbird.mjs package",
    "package:blackbird": "node scripts/build-blackbird.mjs package",
    "dist": "pnpm build && electron-builder",
    "dist:lumen": "node scripts/build-blackbird.mjs dist",
    "dist:blackbird": "node scripts/build-blackbird.mjs dist"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "build": {
    "generateUpdatesFilesForAllChannels": true,
    "appId": "lat.tvr.tmod.desktop",
    "productName": "T-Mod",
    "artifactName": "T-Mod-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/atlas-overlay-hotkey.ps1",
        "to": "atlas-overlay-hotkey.ps1"
      }
    ],
    "icon": "resources/icon.png",
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "resources/icon.ico",
      "target": "nsis",
      "artifactName": "T-Mod-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "T-Mod",
      "uninstallDisplayName": "T-Mod Desktop",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerSidebar": "resources/installer-sidebar.bmp",
      "uninstallerSidebar": "resources/installer-sidebar.bmp",
      "installerHeader": "resources/installer-header.bmp"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "T-Mod-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "background": "resources/dmg-background.png",
      "iconSize": 112,
      "window": {
        "width": 600,
        "height": 420
      },
      "contents": [
        {
          "x": 170,
          "y": 220,
          "type": "file"
        },
        {
          "x": 430,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "artifactName": "T-Mod-Linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cdnserver",
        "repo": "t-mod-releases",
        "releaseType": "release"
      }
    ]
  }
}
