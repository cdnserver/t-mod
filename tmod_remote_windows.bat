@echo off
setlocal EnableExtensions DisableDelayedExpansion

title T-Mod Remote
chcp 65001 >nul
set "TMOD_REMOTE_BUNDLE_PATH=%~f0"
if exist "%~f0.next" (
  set "TMOD_REMOTE_UPDATE_CURRENT=%~f0"
  set "TMOD_REMOTE_UPDATE_NEXT=%~f0.next"
  start "" /b powershell.exe -NoLogo -NoProfile -WindowStyle Hidden -Command "Start-Sleep -Milliseconds 500; Copy-Item -LiteralPath $env:TMOD_REMOTE_UPDATE_NEXT -Destination $env:TMOD_REMOTE_UPDATE_CURRENT -Force; Remove-Item -LiteralPath $env:TMOD_REMOTE_UPDATE_NEXT -Force; Start-Process -FilePath $env:TMOD_REMOTE_UPDATE_CURRENT"
  exit /b 0
)
set "TMOD_BUNDLE_FILE=%~f0"
set "TMOD_PAYLOAD_FILE=%TEMP%\tmod_remote_payload-%RANDOM%-%RANDOM%.ps1"
powershell.exe -NoLogo -NoProfile -NonInteractive -Command "$raw=[IO.File]::ReadAllText($env:TMOD_BUNDLE_FILE); $marker=':__TMOD_REMOTE_PAYLOAD__'; $offset=$raw.LastIndexOf($marker, [StringComparison]::Ordinal); if($offset -lt 0){exit 41}; $encoded=$raw.Substring($offset+$marker.Length) -replace '\s',''; [IO.File]::WriteAllBytes($env:TMOD_PAYLOAD_FILE,[Convert]::FromBase64String($encoded))"
if errorlevel 1 (
  echo.
  echo  [T-MOD] Embedded control payload is damaged.
  pause
  exit /b 41
)
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%TMOD_PAYLOAD_FILE%" %*
set "TMOD_EXIT=%ERRORLEVEL%"
del /q "%TMOD_PAYLOAD_FILE%" >nul 2>nul
if not "%TMOD_EXIT%"=="0" (
  echo.
  echo  T-Mod Remote finished with code %TMOD_EXIT%.
  pause
)
exit /b %TMOD_EXIT%
