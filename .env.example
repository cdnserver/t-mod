# Stability settings for OpenRouter audio output.
# Lyria/OpenRouter can sometimes return text-only chunks if requests are repeated too fast.
OPENROUTER_FALLBACK_MODEL=google/lyria-3-clip-preview
OPENROUTER_AUDIO_RETRY_ATTEMPTS=4
OPENROUTER_AUDIO_RETRY_DELAY_SECONDS=18
OPENROUTER_AUDIO_STRICT_PROMPT=true
OPENROUTER_FORCE_NO_FALLBACKS=false
OPENROUTER_DEBUG_SAVE_STREAM=true
SGLAUDIO_MIN_SECONDS_BETWEEN_REQUESTS=45

# Keep retrying until OpenRouter starts returning audio. 0 = unlimited.
OPENROUTER_AUDIO_START_MAX_ATTEMPTS=0
OPENROUTER_AUDIO_START_RETRY_DELAY_SECONDS=20
