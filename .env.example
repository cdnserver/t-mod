MARKET_MAX_ALERTS_PER_USER=20
MARKET_ALERT_MAX_DELIVERY_ATTEMPTS=3
MARKET_ALERT_RETRY_SECONDS=600

# SGL Audio AI music generation through OpenRouter.
# Put the real key only into C:\Users\Admin\Documents\SGLDiscordBot\.env.
# If the key was shared anywhere, rotate it in OpenRouter before use.
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE
OPENROUTER_MODEL=google/lyria-3-pro-preview
