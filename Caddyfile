{
	admin off
	servers {
		protocols h1 h2 h3
	}
}

(tmod_backend) {
	encode zstd gzip

	@immutable_assets path /assets/*.woff2 /assets/*.mp3
	header @immutable_assets Cache-Control "public, max-age=2592000, immutable"
	@regular_assets path /assets/*
	header @regular_assets Cache-Control "public, max-age=300, stale-while-revalidate=86400"
	header /favicon.ico Cache-Control "public, max-age=86400"

	handle_path /assets/* {
		root * /srv/tmod
		file_server
	}
	handle /favicon.ico {
		rewrite * /favicon.svg
		root * /srv/tmod
		file_server
	}
	handle {
		reverse_proxy tmod-web:8787 {
			health_uri /gateway-health
			health_interval 30s
			health_timeout 5s
			fail_duration 30s
			max_fails 3
			lb_try_duration 5s
			transport http {
				dial_timeout 3s
				# Atlas may spend up to 90 seconds on a provider response.  The
				# gateway already streams long responses and bounds dead upstreams;
				# do not let the public edge turn valid work into an early HTTP 504.
				response_header_timeout 300s
			}
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), payment=(), usb=()"
		-Server
	}
}

tvr.lat {
	handle / {
		rewrite * /reactor
		import tmod_backend
	}
	handle {
		import tmod_backend
	}
}

