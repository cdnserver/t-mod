# Token of an explicitly authorized Discord test user. Never use the T-Mod bot token.
BROWSER_STREAM_DISCORD_TOKEN=

# Only these Discord user IDs may control the fallback !screen commands.
BROWSER_STREAM_ALLOWED_USER_IDS=123456789012345678

# Shared only by T-Mod and this container. Generate a long random value.
BROWSER_STREAM_CONTROL_TOKEN=
BROWSER_STREAM_API_PORT=8790

# Optional: accept commands only in this text channel.
BROWSER_STREAM_COMMAND_CHANNEL_ID=

# Optional defaults let the service start without the controller being present
# in a voice channel.
BROWSER_STREAM_GUILD_ID=
BROWSER_STREAM_VOICE_CHANNEL_ID=
BROWSER_STREAM_START_URL=https://example.org
BROWSER_STREAM_AUTO_START=false

BROWSER_STREAM_COMMAND_PREFIX=!screen
BROWSER_STREAM_WIDTH=1280
BROWSER_STREAM_HEIGHT=720
BROWSER_STREAM_FPS=30
BROWSER_STREAM_BITRATE_KBPS=2500
BROWSER_STREAM_MAX_BITRATE_KBPS=4000
BROWSER_STREAM_PAGE_LOAD_TIMEOUT_MS=45000

# Give Chromium time to load the capture extension and focus the content tab.
BROWSER_STREAM_CAPTURE_STARTUP_DELAY_MS=1250
BROWSER_STREAM_CAPTURE_FOCUS_DELAY_MS=250
BROWSER_STREAM_VOICE_CONNECT_TIMEOUT_MS=20000

# Chromium flags for private/internal pages with a self-signed certificate.
BROWSER_STREAM_IGNORE_HTTPS_ERRORS=false

# Persisted browser profile directory inside the container.
BROWSER_STREAM_PROFILE_DIR=/data/chrome
