DISCORD_TOKEN=YOUR_TOKEN_HERE
DISCORD_GUILD_ID=1488166642985730188
LOCAL_TIMEZONE=Europe/Riga

# Bot Discord presence/status.
BOT_STATUS_ENABLED=true
BOT_STATUS_TYPE=custom
BOT_STATUS_TEXT=Товарищество - светлый круг
BOT_ONLINE_STATUS=online

# Persistent files. Old installations may still use DATA_DIR=/app/data; this archive keeps /app/data mounted too.
DATA_DIR=/app/persistent/data
DATABASE_FILE=/app/persistent/data/tmod.db
LEGACY_ACTIVITY_FILE=/app/persistent/data/activity.json
LOCALIZATION_FILE=/app/persistent/localization.json

# Activity tracking.
TRACK_ALL_MEMBERS=true
TRACK_ONLY_ROLE_ID=
TRACK_MESSAGES=true
TRACK_MESSAGE_EDITS=true
TRACK_MESSAGE_DELETES=true
TRACK_REACTIONS=true
TRACK_VOICE=true
TRACK_VOICE_STATUS=true
TRACK_TYPING=true
TRACK_MEMBER_UPDATES=true
TRACK_MEMBER_JOIN_LEAVE=true
TRACK_COMMANDS=true
ENABLE_MESSAGE_CONTENT_INTENT=true

# Enable only if PRESENCE INTENT is enabled in Discord Developer Portal.
TRACK_PRESENCE=false
LOG_PRESENCE_EVENTS=false

ACTIVITY_DEBOUNCE_SECONDS=30
ACTIVITY_QUEUE_MAXSIZE=20000
RECENT_EVENTS_LIMIT=15

# SGL Bureau module.
SGBUREAU_CATEGORY_ID=1500836076120576000
SGBUREAU_COMMAND_CHANNEL_ID=1500837640067485717
SGBUREAU_STAFF_ROLE_ID=1500488424191295518
SGBUREAU_CLIENT_ROLE_ID=1500488373666840587
SGBUREAU_NEWS_CHANNEL_ID=1500838788082044978
SGBUREAU_GLOBAL_NEWS_CHANNEL_ID=1492471269365383168

SGBUREAU_START_CHANNEL_ID=1500838151219052574
SGBUREAU_COSTS_CHANNEL_ID=1500838270613852331
SGBUREAU_PORTFOLIO_CHANNEL_ID=1500838320077406311
SGBUREAU_ARCHIVE_CATEGORY_ID=1505657602774798447
SGBUREAU_ARCHIVE_AFTER_SECONDS=86400
SGBUREAU_REORDER_DEBOUNCE_SECONDS=20
SGBUREAU_DEFAULT_LAWYER_ID=902235631952998410
SGBUREAU_EMBED_COLOR=0xD9D9D9
SGBUREAU_LAWYER_BANK_ACCOUNT=215436
SGBUREAU_COURT_FEE_BANK_ACCOUNT=72476

# Majestic external API scaffold. Keep real keys only in this persistent server .env.
# Multiple keys are reserved for approved failover/future pooling; they do not increase the shared limit now.
MAJESTIC_API_ENABLED=false
MAJESTIC_API_BASE_URL=https://api.majestic-files.net
MAJESTIC_API_KEY=
MAJESTIC_API_KEYS=
MAJESTIC_API_LANGUAGE=ru
MAJESTIC_SERVER_ID=RU15
MAJESTIC_API_REQUESTS_PER_WINDOW=5
MAJESTIC_API_WINDOW_SECONDS=60
MAJESTIC_API_TIMEOUT_SECONDS=15
MAJESTIC_API_CACHE_TTL_SECONDS=60
MAJESTIC_API_MAX_RETRIES=1
MAJESTIC_API_RETRY_BACKOFF_SECONDS=1

# SGL Audio AI music generation through OpenRouter.
# Put the real key only into C:\Users\Admin\Documents\SGLDiscordBot\.env.
# If the key was shared anywhere, rotate it in OpenRouter before use.
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE
OPENROUTER_MODEL=google/lyria-3-pro-preview
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_REFERER=
OPENROUTER_TITLE=T-Mod
# OpenRouter audio output requires streaming + modalities/audio config.
OPENROUTER_STREAM_AUDIO=true
OPENROUTER_AUDIO_MODALITIES=text,audio
OPENROUTER_AUDIO_FORMAT=wav
OPENROUTER_AUDIO_VOICE=
SGLAUDIO_COMMAND_CHANNEL_ID=1500837640067485717
SGLAUDIO_OUTPUT_CHANNEL_ID=1500254662765449317
SGLAUDIO_ALLOWED_ROLE_ID=1488207163879985233
SGLAUDIO_EMBED_COLOR=0xD9D9D9
SGLAUDIO_TIMEOUT_SECONDS=600
SGLAUDIO_STATUS_INTERVAL_SECONDS=1
SGLAUDIO_MAX_DISCORD_FILE_BYTES=25165824
SGLAUDIO_OUTPUT_DIR=/app/persistent/data/audio_outputs


# Stability settings for OpenRouter audio output.
# Lyria/OpenRouter can sometimes return text-only chunks if requests are repeated too fast.
OPENROUTER_FALLBACK_MODEL=google/lyria-3-clip-preview
OPENROUTER_AUDIO_RETRY_ATTEMPTS=4
OPENROUTER_AUDIO_RETRY_DELAY_SECONDS=18
OPENROUTER_AUDIO_STRICT_PROMPT=true
OPENROUTER_FORCE_NO_FALLBACKS=false
OPENROUTER_DEBUG_SAVE_STREAM=true
SGLAUDIO_MIN_SECONDS_BETWEEN_REQUESTS=45

# Keep retrying until OpenRouter starts returning audio. 0 = unlimited.
OPENROUTER_AUDIO_START_MAX_ATTEMPTS=0
OPENROUTER_AUDIO_START_RETRY_DELAY_SECONDS=20
# TSG document generator test command.

# Zigmund AI image generation
ZIGMUND_MODEL=x-ai/grok-imagine-image-quality
ZIGMUND_COMMAND_CHANNEL_ID=1500837640067485717
ZIGMUND_ALLOWED_ROLE_ID=1488207163879985233
ZIGMUND_EMBED_COLOR=0xD9D9D9
ZIGMUND_TIMEOUT_SECONDS=300
ZIGMUND_OUTPUT_DIR=/app/persistent/data/zigmund_outputs
ZIGMUND_PROMPT_PREFIX=Сгенерируй аниме эччи картинку.
ZIGMUND_SEND_AS_SPOILER=true
ZIGMUND_MAX_ATTEMPTS=3
ZIGMUND_RETRY_DELAY_SECONDS=8

# Pretty startup logs inside Docker logs.
BOOT_LOG_ENABLED=true
# SGL contract generator.
SGL_CONTRACT_TEMPLATE_PATH=/app/persistent/templates/dogovorv1.docx
SGL_CONTRACT_BUNDLED_TEMPLATE_PATH=/app/templates/dogovorv1.docx
SGL_CONTRACT_OUTPUT_DIR=/app/persistent/generated/contracts
SGL_CONTRACT_IMAGE_DPI=200
SGL_CONTRACT_EMBED_COLOR=0xD9D9D9
SGL_CONTRACT_MAX_FILE_BYTES=25165824

# Sync bundled final SGL contract template into persistent templates folder on startup.
SGL_CONTRACT_SYNC_BUNDLED_TEMPLATE=true

